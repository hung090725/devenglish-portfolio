<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_backup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/window_background"
            app:title="Sao lưu / Khôi phục tiến độ"
            app:titleTextColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sao lưu giúp bạn giữ tiến độ khi cài lại app. Hãy lưu JSON vào Ghi chú, Zalo hoặc Google Keep."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txt_progress_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang tải..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <EditText
            android:id="@+id/et_json_content"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:gravity="top|start"
            android:hint="Dán chuỗi JSON Backup vào đây hoặc xuất ra để copy..."
            android:inputType="textMultiLine"
            android:background="@drawable/card_rounded_bg"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Xóa"
                android:contentDescription="Xóa trắng ô nhập liệu"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Dán"
                android:contentDescription="Dán từ Clipboard"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Copy"
                android:contentDescription="Copy vào Clipboard"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_json"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="💾 Tạo chuỗi JSON Sao lưu"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_json"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="📥 Khôi phục từ ô nhập liệu"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:text="Export Diagnostics (Gửi cho Dev)"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/txt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
