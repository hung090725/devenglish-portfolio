<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kiểm tra trình độ"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvQuestionProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Câu 1 / 30"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đang tải câu hỏi..."
        android:textSize="18sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnOptionA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option A"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnOptionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option B"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnOptionC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option C"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnOptionD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option D"
        android:layout_marginBottom="24dp"/>

    <!-- Vùng hiển thị kết quả -->
    <LinearLayout
        android:id="@+id/layoutResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvResultSuggestedLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trình độ gợi ý: A2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvResultExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giải thích tại sao..."
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnStartSuggested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bắt đầu học từ trình độ gợi ý"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnStartA0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tôi muốn học từ con số 0 (A0)"/>
    </LinearLayout>

</LinearLayout>
