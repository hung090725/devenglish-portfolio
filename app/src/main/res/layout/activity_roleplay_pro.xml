<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvRoleplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Role-play Pro"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:gravity="center" />
        
    <TextView
        android:id="@+id/tvSituation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tình huống đàm thoại..."
        android:textSize="16sp"
        android:textColor="@color/gray"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn vai của bạn:"
            android:layout_marginEnd="8dp"/>
            
        <Spinner
            android:id="@+id/spinnerRoleSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">
        
        <LinearLayout
            android:id="@+id/layoutChatHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <Button
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤 NÓI"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"/>
            
        <TextView
            android:id="@+id/tvRecognizedText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Nhấn nút và nói..."
            android:textSize="14sp"
            android:textColor="@color/gray"/>
            
        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GỬI"/>
    </LinearLayout>

</LinearLayout>
