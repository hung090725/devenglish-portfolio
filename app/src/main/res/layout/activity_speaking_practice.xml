<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/txt_prompt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Luyện Nói Phát Âm"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTENT BOX -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/surface_background"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Dành cho chế độ dịch -->
            <TextView
                android:id="@+id/txt_translation_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dịch câu Việt sang Anh"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textAlignment="center"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Câu tiếng Anh mẫu -->
            <TextView
                android:id="@+id/txt_target_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My name is Hung."
                android:textColor="@color/purple_start"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <!-- Nút nghe phát âm chuẩn -->
            <Button
                android:id="@+id/btn_speak_target"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/cd_listen_target"
                android:text="Nghe giọng chuẩn"
                android:textColor="@color/white"
                android:background="@drawable/button_gradient"
                app:backgroundTint="@null"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- KẾT QUẢ PHÂN TÍCH (ẨN MẶC ĐỊNH) -->
    <LinearLayout
        android:id="@+id/layout_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/card_target">

        <!-- Điểm số và text đã nhận diện -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/surface_background"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/txt_score_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điểm số: 85%"
                    android:textColor="@color/success"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_user_speak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bạn nói: my name is hung"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textAlignment="center" />

                <!-- So khớp từ trực quan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/txt_correct_words"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Từ đúng: my, name, is, hung"
                        android:textColor="@color/success"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_missing_words"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Từ thiếu: --"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_wrong_words"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Từ sai/dư: --"
                        android:textColor="@color/error"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- MICROPHONE GHI ÂM (DƯỚI CÙNG) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhấn nút Micro để bắt đầu nói"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <FrameLayout
            android:id="@+id/btn_record"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/button_gradient"
            app:backgroundTint="@null"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_microphone">
            <ImageView
                android:id="@+id/img_record_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/cd_microphone"
                app:tint="@color/white" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
