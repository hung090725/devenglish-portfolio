<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_rounded_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txt_question_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Câu 1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_your_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Bạn chọn: A"
        android:textColor="@color/error"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txt_correct_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Đáp án đúng: B"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txt_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Giải thích"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAskAi"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2563EB"
        android:text="💡 Hỏi AI giải thích chi tiết"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
