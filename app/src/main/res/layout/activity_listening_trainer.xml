<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvListeningTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listening Trainer"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:gravity="center" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nghe đoạn văn và điền từ còn thiếu:"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnPlayAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶ PHÁT AUDIO"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvSentenceWithBlanks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="She ____ to the market every ____."
        android:textSize="18sp"
        android:lineSpacingExtra="8dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập các từ còn thiếu, cách nhau bởi dấu phẩy"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSubmitAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KIỂM TRA"
        android:backgroundTint="@color/teal_700"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:gravity="center" />

</LinearLayout>
