<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvSpeakingProTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Speaking Trainer Pro"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:gravity="center" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đọc to câu sau:"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvSentenceToSpeak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I want to improve my English speaking skills."
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnMic"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="🎤"
        android:textSize="32sp"
        android:backgroundTint="@color/teal_700"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvRecognizedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bạn đã nói: ..."
        android:textSize="16sp"
        android:textColor="@color/gray"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Điểm: 0/100"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/purple_500"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

</LinearLayout>
