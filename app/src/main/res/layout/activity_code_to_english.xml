<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#1E293B">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Quay lại"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code-to-English AI Lab"
                android:textColor="#38BDF8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chấm điểm độc lập: Kỹ Thuật (Tech) &amp; Tiếng Anh"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNextSnippet"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#2563EB"
            android:text="Bài khác ➔"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Code Info Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvSnippetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hàm tính tổng hai số nguyên"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLanguageBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#334155"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Java"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- IDE Code Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#000000"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- IDE Window bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:background="#1E293B"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:orientation="horizontal">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#EF4444" android:layout_marginEnd="5dp"/>
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#F59E0B" android:layout_marginEnd="5dp"/>
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#10B981" />
                        <TextView
                            android:id="@+id/tvSnippetLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Snippet • Junior Level"
                            android:textColor="#64748B"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCodeContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:fontFamily="monospace"
                        android:text="public int calculateSum(int a, int b) {\n    return a + b;\n}"
                        android:textColor="#34D399"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Prompt instructions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Nhiệm vụ của bạn (Task):\n'Explain what this function does in English.'"
                android:textColor="#FCD34D"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Input area -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etUserExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_viewfinder_border"
                    android:gravity="top|start"
                    android:hint="Type or speak in English: 'This function takes two integers and returns their sum...'"
                    android:padding="12dp"
                    android:paddingEnd="48dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <!-- Speech mic button -->
                <ImageButton
                    android:id="@+id/btnMicInput"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Nói qua Micro"
                    app:tint="#38BDF8" />
            </RelativeLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnEvaluate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:text="✨ AI Chấm Điểm Độc Lập"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHint"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#334155"
                    android:text="💡 Gợi ý"
                    android:textAllCaps="false"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Results Card (Independent Rubric Scores) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1E293B"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 KẾT QUẢ ĐÁNH GIÁ ĐỘC LẬP"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Dual Score meters -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- Technical Score Box -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#0F172A"
                            android:padding="12dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ĐÚNG KỸ THUẬT"
                                android:textColor="#94A3B8"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTechScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="95%"
                                android:textColor="#10B981"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- English Score Box -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#0F172A"
                            android:padding="12dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TIẾNG ANH &amp; NGỮ PHÁP"
                                android:textColor="#94A3B8"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEnglishScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="88%"
                                android:textColor="#38BDF8"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Technical Feedback -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 Nhận xét Kiến thức CNTT:"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvTechFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Logic hoàn toàn chính xác."
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp"
                        android:layout_marginTop="2dp" />

                    <!-- English Feedback -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 Nhận xét Diễn đạt Tiếng Anh:"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tvEnglishFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Câu văn chuẩn xác, dùng đúng từ chuyên ngành."
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp"
                        android:layout_marginTop="2dp" />

                    <!-- Ideal Expression & TTS audio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌟 Cách diễn đạt tự nhiên hơn (Native phrasing):"
                                android:textColor="#FCD34D"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnSpeakIdeal"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_lock_silent_mode_off"
                                android:contentDescription="Phát âm câu mẫu"
                                app:tint="#38BDF8" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvIdealExpression"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="This function takes two integer arguments, a and b, and returns their sum as an integer."
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Keywords matched -->
                    <TextView
                        android:id="@+id/tvKeyTermsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="• Thuật ngữ đã dùng: takes, returns, sum"
                        android:textColor="#34D399"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
