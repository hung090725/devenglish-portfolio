<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#1E293B">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Quay lại"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT English Interview Simulator"
                android:textColor="#38BDF8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô phỏng phỏng vấn tuyển dụng IT • Chấm theo Rubric"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNextQuestion"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#8B5CF6"
            android:text="Câu khác ➔"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Role & Round Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2563EB"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Junior Java Developer"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoundBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#334155"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Vòng 1: Giới thiệu bản thân"
                    android:textColor="#F59E0B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Interviewer Speech Bubble -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1E293B"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👔 AI Technical Interviewer:"
                            android:textColor="#38BDF8"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnSpeakQuestion"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:backgroundTint="#334155"
                            android:text="🔊 Nghe hỏi"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuestionEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Could you walk me through your background and why you are interested in this position?"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/tvQuestionVi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Bạn có thể giới thiệu về bản thân và lý do ứng tuyển vào vị trí này không?"
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Candidate Answer Area -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎙️ Câu trả lời của bạn (Candidate Response):"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etCandidateAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_viewfinder_border"
                    android:gravity="top|start"
                    android:hint="Nói vào micro hoặc gõ câu trả lời bằng tiếng Anh..."
                    android:padding="12dp"
                    android:paddingEnd="48dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnMicInterview"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Ghi âm câu trả lời"
                    app:tint="#8B5CF6" />
            </RelativeLayout>

            <!-- Submit evaluation button -->
            <Button
                android:id="@+id/btnSubmitAnswer"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="#8B5CF6"
                android:text="🏆 Chấm Điểm Phỏng Vấn (Rubric Score)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Assessment Report Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInterviewReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1E293B"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 BÁO CÁO PHỎNG VẤN TIẾNG ANH IT"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Rubric Breakdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#0F172A"
                            android:padding="10dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐIỂM TỔNG" android:textColor="#94A3B8" android:textSize="9.5sp"/>
                            <TextView android:id="@+id/tvOverallScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="85%" android:textColor="#10B981" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#0F172A"
                            android:padding="10dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KỸ THUẬT" android:textColor="#94A3B8" android:textSize="9.5sp"/>
                            <TextView android:id="@+id/tvScoreTech" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="90%" android:textColor="#38BDF8" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#0F172A"
                            android:padding="10dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TỪ VỰNG IT" android:textColor="#94A3B8" android:textSize="9.5sp"/>
                            <TextView android:id="@+id/tvScoreVocab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80%" android:textColor="#F59E0B" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#0F172A"
                            android:padding="10dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LƯU LOÁT" android:textColor="#94A3B8" android:textSize="9.5sp"/>
                            <TextView android:id="@+id/tvScoreFluency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="85%" android:textColor="#A855F7" android:textSize="18sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Evaluation Feedback text -->
                    <TextView
                        android:id="@+id/tvInterviewFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nhận xét từ AI..."
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <!-- Sample Band 7.5+ Answer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌟 Câu trả lời mẫu xuất sắc (Band 7.5+):"
                                android:textColor="#FCD34D"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnSpeakSample"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_lock_silent_mode_off"
                                android:contentDescription="Nghe mẫu câu trả lời"
                                app:tint="#38BDF8" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSampleAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="..."
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                    <!-- Interview Tips -->
                    <TextView
                        android:id="@+id/tvInterviewTips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="..."
                        android:textColor="#34D399"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
