<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Apptienganh" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_start</item>
        <item name="colorSecondary">@color/purple_end</item>
        <item name="colorAccent">@color/cyan_accent</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/purple_start</item>
    </style>

    <style name="Theme.Apptienganh" parent="Base.Theme.Apptienganh" />
    
    <style name="Theme.Apptienganh.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Apptienganh</item>
    </style>
</resources>