<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF"> <!-- Ripple màu trắng bán trong suốt -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/purple_start"
                android:endColor="@color/purple_end"
                android:type="linear" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</ripple>
